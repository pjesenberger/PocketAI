    "They sit above the keyboard. Tap one before sending to change the answer. Choose the ones to show." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توجد فوق لوحة المفاتيح. اضغط على واحد قبل الإرسال لتغيير الرد. اختر ما يظهر منها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sind über der Tastatur. Tippe vor dem Senden auf einen, um die Antwort zu ändern. Wähle, welche angezeigt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Están sobre el teclado. Toca uno antes de enviar para cambiar la respuesta. Elige cuáles mostrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils sont au-dessus du clavier. Touchez-en un avant d'envoyer pour changer la réponse. Choisissez ceux à afficher."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये कीबोर्ड के ऊपर रहते हैं। जवाब बदलने के लिए भेजने से पहले किसी एक पर टैप करें। चुनें कि कौन से दिखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada di atas papan ketik. Ketuk satu sebelum mengirim untuk mengubah jawaban. Pilih yang ingin ditampilkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono sopra la tastiera. Toccane una prima di inviare per cambiare la risposta. Scegli quali mostrare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードの上に表示されます。送信前にタップすると答え方が変わります。表示するものを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키보드 위에 있어요. 보내기 전에 탭하면 답변이 바뀝니다. 표시할 단축어를 고르세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze staan boven het toetsenbord. Tik er een aan voor het versturen om het antwoord te veranderen. Kies welke je wilt zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Są nad klawiaturą. Stuknij jeden przed wysłaniem, by zmienić odpowiedź. Wybierz, które pokazać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ficam acima do teclado. Toque em um antes de enviar para mudar a resposta. Escolha quais mostrar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они над клавиатурой. Нажмите на одну перед отправкой, чтобы изменить ответ. Выберите, какие показывать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De finns ovanför tangentbordet. Tryck på en innan du skickar för att ändra svaret. Välj vilka som visas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อยู่เหนือแป้นพิมพ์ แตะก่อนส่งเพื่อเปลี่ยนคำตอบ เลือกว่าจะแสดงอันไหน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klavyenin üstündeler. Göndermeden önce birine dokunarak yanıtı değiştir. Hangilerinin görüneceğini seç."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вони над клавіатурою. Торкніться однієї перед надсиланням, щоб змінити відповідь. Оберіть, які показувати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nằm phía trên bàn phím. Chạm một phím trước khi gửi để đổi câu trả lời. Chọn những phím muốn hiện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它们位于键盘上方。发送前轻点一个即可改变回答。选择要显示的快捷指令。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它們位於鍵盤上方。傳送前點一下即可改變回答。選擇要顯示的捷徑。"
