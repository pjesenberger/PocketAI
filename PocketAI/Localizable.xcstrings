    "No account, no cloud, no tracking. Your chats stay with you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا حساب، لا سحابة، لا تتبّع. محادثاتك تبقى معك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Konto, keine Cloud, kein Tracking. Deine Chats bleiben bei dir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuenta, sin nube, sin rastreo. Tus chats se quedan contigo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de compte, pas de cloud, aucun suivi. Vos conversations restent chez vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई अकाउंट नहीं, कोई क्लाउड नहीं, कोई ट्रैकिंग नहीं। आपकी चैट आपके पास रहती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa akun, tanpa cloud, tanpa pelacakan. Obrolan Anda tetap milik Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun account, nessun cloud, nessun tracciamento. Le tue chat restano con te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント不要、クラウドなし、トラッキングなし。チャットはあなたの手元に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정, 클라우드, 추적이 없습니다. 대화는 오직 사용자에게만 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen account, geen cloud, geen tracking. Je chats blijven bij jou."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez konta, bez chmury, bez śledzenia. Twoje czaty zostają przy Tobie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem conta, sem nuvem, sem rastreamento. Suas conversas ficam com você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без аккаунта, без облака, без отслеживания. Ваши чаты остаются у вас."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget konto, inget moln, ingen spårning. Dina chattar stannar hos dig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ต้องมีบัญชี ไม่มีคลาวด์ ไม่มีการติดตาม แชทของคุณอยู่กับคุณเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesap yok, bulut yok, takip yok. Sohbetlerin sende kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без акаунта, без хмари, без стеження. Ваші чати залишаються з вами."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tài khoản, không đám mây, không theo dõi. Cuộc trò chuyện chỉ ở với bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需账户，没有云端，没有追踪。你的聊天只属于你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無需帳號，沒有雲端，沒有追蹤。你的聊天只屬於你。"
          }
        }
      }
    },
