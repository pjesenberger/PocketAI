    "Paste a model ID or link from Hugging Face. MLX models from mlx-community work best." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصق معرّف نموذج أو رابطه من Hugging Face. تعمل نماذج MLX من mlx-community بشكل أفضل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge die ID oder den Link eines Hugging Face-Modells ein. MLX-Modelle von mlx-community funktionieren am besten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega el ID o el enlace de un modelo de Hugging Face. Los modelos MLX de mlx-community funcionan mejor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez l'identifiant ou le lien d'un modèle Hugging Face. Les modèles MLX de mlx-community fonctionnent le mieux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hugging Face मॉडल का ID या लिंक पेस्ट करें। mlx-community के MLX मॉडल सबसे अच्छे चलते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempel ID atau tautan model dari Hugging Face. Model MLX dari mlx-community bekerja paling baik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incolla l'ID o il link di un modello Hugging Face. I modelli MLX di mlx-community funzionano meglio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hugging Face のモデル ID かリンクを貼り付けてください。mlx-community の MLX モデルがおすすめです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hugging Face 모델 ID나 링크를 붙여 넣으세요. mlx-community의 MLX 모델이 가장 잘 작동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plak de ID of link van een Hugging Face-model. MLX-modellen van mlx-community werken het best."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wklej ID lub link modelu z Hugging Face. Najlepiej działają modele MLX z mlx-community."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cole o ID ou o link de um modelo do Hugging Face. Modelos MLX do mlx-community funcionam melhor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставьте ID или ссылку на модель Hugging Face. Лучше всего работают модели MLX из mlx-community."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klistra in ID eller länk till en Hugging Face-modell. MLX-modeller från mlx-community fungerar bäst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วาง ID หรือลิงก์ของโมเดลจาก Hugging Face โมเดล MLX จาก mlx-community ใช้งานได้ดีที่สุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir Hugging Face modelinin kimliğini veya bağlantısını yapıştır. En iyi mlx-community'deki MLX modelleri çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставте ID або посилання на модель Hugging Face. Найкраще працюють моделі MLX з mlx-community."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dán ID hoặc liên kết mô hình từ Hugging Face. Mô hình MLX từ mlx-community hoạt động tốt nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴 Hugging Face 模型 ID 或链接。mlx-community 的 MLX 模型效果最好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼上 Hugging Face 模型 ID 或連結。mlx-community 的 MLX 模型效果最好。"
          }
        }
      }
