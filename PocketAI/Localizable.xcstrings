    "The AI works directly on your device. Nothing is sent to a server." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل الذكاء الاصطناعي مباشرةً على جهازك. لا يُرسل أي شيء إلى خادم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI arbeitet direkt auf deinem Gerät. Nichts wird an einen Server gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La IA funciona directamente en tu dispositivo. No se envía nada a ningún servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IA fonctionne directement sur votre appareil. Rien n’est envoyé à un serveur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI सीधे आपके डिवाइस पर काम करता है। सर्वर पर कुछ भी नहीं भेजा जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI bekerja langsung di perangkat Anda. Tidak ada yang dikirim ke server."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IA funziona direttamente sul tuo dispositivo. Nulla viene inviato a un server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIはデバイス上で直接動作します。サーバーには何も送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI가 기기에서 직접 작동합니다. 서버로 아무것도 전송되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De AI werkt direct op je apparaat. Er wordt niets naar een server gestuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI działa bezpośrednio na Twoim urządzeniu. Nic nie jest wysyłane na serwer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A IA funciona direto no seu dispositivo. Nada é enviado a um servidor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ИИ работает прямо на вашем устройстве. Ничего не отправляется на сервер."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI:n arbetar direkt på din enhet. Inget skickas till en server."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI ทำงานบนอุปกรณ์ของคุณโดยตรง ไม่มีการส่งข้อมูลใดไปยังเซิร์ฟเวอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
