    "Apple's on-device model blocked this request. Try rephrasing it or use a downloaded model." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حظر نموذج Apple على الجهاز هذا الطلب. جرّب إعادة صياغته أو استخدم نموذجًا تم تنزيله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das On-Device-Modell von Apple hat diese Anfrage blockiert. Formuliere sie um oder nutze ein heruntergeladenes Modell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo de Apple en el dispositivo bloqueó esta solicitud. Reformúlala o usa un modelo descargado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle d'Apple sur l'appareil a bloqué cette demande. Reformulez-la ou utilisez un modèle téléchargé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple के ऑन-डिवाइस मॉडल ने इस अनुरोध को रोक दिया। इसे दूसरे शब्दों में लिखें या डाउनलोड किया गया मॉडल इस्तेमाल करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model di perangkat Apple memblokir permintaan ini. Coba ubah kata-katanya atau gunakan model yang diunduh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello di Apple sul dispositivo ha bloccato questa richiesta. Prova a riformularla o usa un modello scaricato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleのオンデバイスモデルがこのリクエストをブロックしました。言い換えるか、ダウンロードしたモデルを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple의 기기 내 모델이 이 요청을 차단했습니다. 다르게 표현하거나 다운로드한 모델을 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het on-device model van Apple heeft dit verzoek geblokkeerd. Formuleer het anders of gebruik een gedownload model."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model Apple na urządzeniu zablokował tę prośbę. Spróbuj ją przeformułować lub użyj pobranego modelu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modelo da Apple no dispositivo bloqueou esta solicitação. Tente reformulá-la ou use um modelo baixado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модель Apple на устройстве заблокировала этот запрос. Попробуйте переформулировать его или используйте загруженную модель."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apples modell på enheten blockerade begäran. Formulera om den eller använd en nedladdad modell."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โมเดลของ Apple บนอุปกรณ์บล็อกคำขอนี้ ลองเรียบเรียงใหม่หรือใช้โมเดลที่ดาวน์โหลดไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple'ın cihaz üzerindeki modeli bu isteği engelledi. Farklı ifade etmeyi deneyin veya indirilmiş bir model kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модель Apple на пристрої заблокувала цей запит. Спробуйте переформулювати його або скористайтеся завантаженою моделлю."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mô hình trên thiết bị của Apple đã chặn yêu cầu này. Hãy thử diễn đạt lại hoặc dùng mô hình đã tải xuống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 的设备端模型阻止了此请求。请换种说法，或使用已下载的模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 的裝置端模型阻擋了此請求。請換個說法，或使用已下載的模型。"
          }
        }
      }
    },
