    "Meta's lightest model. Quick answers on any device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخف نموذج من Meta. إجابات سريعة على أي جهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das leichteste Modell von Meta. Schnelle Antworten auf jedem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo más ligero de Meta. Respuestas rápidas en cualquier dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle le plus léger de Meta. Des réponses rapides sur tout appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta का सबसे हल्का मॉडल। किसी भी डिवाइस पर तुरंत जवाब।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model Meta paling ringan. Jawaban cepat di perangkat apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello più leggero di Meta. Risposte rapide su qualsiasi dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metaの最軽量モデル。どのデバイスでもすばやく回答。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta의 가장 가벼운 모델. 모든 기기에서 빠르게 답변."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het lichtste model van Meta. Snelle antwoorden op elk apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najlżejszy model Meta. Szybkie odpowiedzi na każdym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modelo mais leve da Meta. Respostas rápidas em qualquer dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Самая легкая модель Meta. Быстрые ответы на любом устройстве."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metas lättaste modell. Snabba svar på alla enhetsmodeller."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โมเดลที่เบาที่สุดของ Meta ตอบเร็วบนทุกอุปกรณ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta'nın en hafif modeli. Her cihazda hızlı yanıtlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найлегша модель Meta. Швидкі відповіді на будь-якому пристрої."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mô hình nhẹ nhất của Meta. Trả lời nhanh trên mọi thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta 最轻量的模型。在任何设备上都能快速回答。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta 最輕量的模型。在任何裝置上都能快速回答。"
          }
        }
      }
    },
