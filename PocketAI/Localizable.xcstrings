    "It runs on your device. Download it once, then use it offline." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل على جهازك. نزّله مرة واحدة، ثم استخدمه دون اتصال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie läuft auf deinem Gerät. Einmal laden, dann offline nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona en tu dispositivo. Descárgala una vez y úsala sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle fonctionne sur votre appareil. Téléchargez-la une fois, puis utilisez-la hors ligne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह आपके डिवाइस पर चलता है। एक बार डाउनलोड करें, फिर ऑफ़लाइन इस्तेमाल करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI ini berjalan di perangkat Anda. Unduh sekali, lalu gunakan secara offline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funziona sul tuo dispositivo. Scaricala una volta e usala offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス上で動作します。一度ダウンロードすれば、オフラインで使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기에서 실행됩니다. 한 번 다운로드하면 오프라인으로 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij draait op je apparaat. Eén keer downloaden, daarna offline gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Działa na Twoim urządzeniu. Pobierz ją raz i korzystaj offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela roda no seu dispositivo. Baixe uma vez e use offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он работает на вашем устройстве. Скачайте один раз и пользуйтесь офлайн."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den körs på din enhet. Ladda ner den en gång och använd den offline."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำงานบนอุปกรณ์ของคุณ ดาวน์โหลดครั้งเดียว แล้วใช้งานแบบออฟไลน์ได้เลย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cihazında çalışır. Bir kez indir, sonra çevrimdışı kullan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Він працює на вашому пристрої. Завантажте один раз і користуйтеся офлайн."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI chạy trên thiết bị của bạn. Tải về một lần, rồi dùng ngoại tuyến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它在你的设备上运行。下载一次，即可离线使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它在你的裝置上執行。下載一次，即可離線使用。"
          }
        }
      }
    },
